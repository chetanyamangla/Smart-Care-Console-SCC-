#define BLYNK_TEMPLATE_ID   "YOUR_BLYNK_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "YOUR_BLYNK_TEMPLATE_NAME"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_AUTH_TOKEN"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>

char ssid[] = "SSID";
char pass[] = "PASSWORD";

// Output Pins
#define LED_PIN        18
#define FAN_PIN        5
#define TV_PIN         4
#define MASSAGER_PIN   19

BLYNK_CONNECTED()
{
  Serial.println("✅ Blynk Connected");
  Blynk.syncAll();
}

// ---------------------- LED ----------------------
BLYNK_WRITE(V0)
{
  int state = param.asInt();

  Serial.print("V0 (LED) = ");
  Serial.println(state);

  digitalWrite(LED_PIN, state);

  Serial.print("GPIO18 = ");
  Serial.println(digitalRead(LED_PIN));
}

// ---------------------- FAN ----------------------
BLYNK_WRITE(V1)
{
  int state = param.asInt();

  Serial.print("V1 (FAN) = ");
  Serial.println(state);

  digitalWrite(FAN_PIN, state);

  Serial.print("GPIO5 = ");
  Serial.println(digitalRead(FAN_PIN));
}

// ---------------------- TV ----------------------
BLYNK_WRITE(V2)
{
  int state = param.asInt();

  Serial.print("V2 (TV) = ");
  Serial.println(state);

  digitalWrite(TV_PIN, state);

  Serial.print("GPIO4 = ");
  Serial.println(digitalRead(TV_PIN));
}

// ---------------------- MASSAGER ----------------------
BLYNK_WRITE(V3)
{
  int state = param.asInt();

  Serial.print("V3 (MASSAGER) = ");
  Serial.println(state);

  digitalWrite(MASSAGER_PIN, state);

  Serial.print("GPIO19 = ");
  Serial.println(digitalRead(MASSAGER_PIN));
}

void setup()
{
  Serial.begin(115200);

  pinMode(LED_PIN, OUTPUT);
  pinMode(FAN_PIN, OUTPUT);
  pinMode(TV_PIN, OUTPUT);
  pinMode(MASSAGER_PIN, OUTPUT);

  digitalWrite(LED_PIN, LOW);
  digitalWrite(FAN_PIN, LOW);
  digitalWrite(TV_PIN, LOW);
  digitalWrite(MASSAGER_PIN, LOW);

  Serial.println("--------------------------------");
  Serial.println("ESP32 Output Test Started");
  Serial.println("--------------------------------");

  WiFi.begin(ssid, pass);

  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED)
  {
    Serial.print(".");
    delay(500);
  }

  Serial.println();
  Serial.println("✅ WiFi Connected");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
}

void loop()
{
  Blynk.run();
}
