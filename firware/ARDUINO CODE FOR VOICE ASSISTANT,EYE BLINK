int led = 3;
#define IR A0
#define BUZZER 13
int lcd = 4;
int fan = 6;
int massager = 5;

unsigned int receivedValue = 0;

bool commandMode = false;
bool eyeWasClosed = false;

unsigned long eyeCloseStart = 0;
unsigned long blinkStart = 0;
unsigned long lastBlinkTime = 0;

int blinkCount = 0;
int lastEyeState = LOW;   // LOW = OPEN, HIGH = CLOSED

void beep(unsigned int t)
{
  digitalWrite(BUZZER, HIGH);
  delay(t);
  digitalWrite(BUZZER, LOW);
  delay(20);
}

void setup()
{
  pinMode(IR, INPUT);
  pinMode(led, OUTPUT);
  pinMode(fan, OUTPUT);
  pinMode(massager, OUTPUT);
  pinMode(lcd, OUTPUT);
  pinMode(BUZZER, OUTPUT);

  Serial.begin(9600);

  digitalWrite(led, LOW);
  digitalWrite(fan, LOW);
  digitalWrite(lcd, LOW);
  digitalWrite(massager, LOW);
  digitalWrite(BUZZER, LOW);

  Serial.println("=== Eye Controlled System Started ===");

  beep(200);
}

void loop()
{
  if (Serial.available() >= 2)
  {
    Serial.println("Data From VC-02");

    byte highByte = Serial.read();
    byte lowByte = Serial.read();

    receivedValue = (highByte << 8) | lowByte;

    Serial.print("Received HEX value: 0x");
    Serial.println(receivedValue, HEX);
  }

  // LCD
  if (receivedValue == 0xC190)
  {
    digitalWrite(lcd, HIGH);
    
  }
  else if (receivedValue == 0xC090)
  {
    digitalWrite(lcd, LOW);
    
  }

  // LED
  if (receivedValue == 0xA190)
  {
    digitalWrite(led, HIGH);
    
  }
  else if (receivedValue == 0xA090)
  {
    digitalWrite(led, LOW);
    
  }

  // FAN
  if (receivedValue == 0xB190)
  {
    digitalWrite(fan, HIGH);
    
  }
  else if (receivedValue == 0xB090)
  {
    digitalWrite(fan, LOW);
    
  }

  // MASSAGER
  if (receivedValue == 0xD190)
  {
    digitalWrite(massager, HIGH);
    
  }
  else if (receivedValue == 0xD090)
  {
    digitalWrite(massager, LOW);
    
  }

  delay(10);
  receivedValue = 0;

  int sensorValue = analogRead(IR);
  int eyeState = (sensorValue < 400) ? HIGH : LOW;

  unsigned long now = millis();

  if (eyeState != lastEyeState)
  {
    if (eyeState == HIGH)
      Serial.println("Eye CLOSED");
    else
      Serial.println("Eye OPENED");

    lastEyeState = eyeState;
  }

  if (!commandMode)
  {
    if (eyeState == HIGH)
    {
      if (!eyeWasClosed)
      {
        eyeCloseStart = now;
        eyeWasClosed = true;
      }

      if (now - eyeCloseStart >= 3000)
      {
        commandMode = true;
        blinkCount = 0;
        lastBlinkTime = now;

        eyeWasClosed = false;
        blinkStart = 0;

        Serial.println(">>> COMMAND MODE ENTERED");
        beep(500);
      }
    }
    else
    {
      eyeWasClosed = false;
    }

    return;
  }

  if (commandMode)
  {
    if (eyeState == HIGH && !eyeWasClosed)
    {
      blinkStart = now;
      eyeWasClosed = true;
    }

    if (eyeState == LOW && eyeWasClosed)
    {
      unsigned long blinkDuration = now - blinkStart;
      eyeWasClosed = false;

      Serial.print("Blink Duration: ");
      Serial.print(blinkDuration);
      Serial.println(" ms");

      if (blinkDuration >= 100 && blinkDuration <= 800)
      {
        blinkCount++;
        lastBlinkTime = now;

        Serial.print("Blink COUNTED: ");
        Serial.println(blinkCount);

        beep(80);
      }
      else
      {
        Serial.println("Blink ignored");
      }
    }

    if (blinkCount > 0 && (now - lastBlinkTime > 2000))
    {
      Serial.print("Executing command for ");
      Serial.print(blinkCount);
      Serial.println(" blinks");
            if (blinkCount == 1)
      {
        digitalWrite(led, HIGH);
        Serial.println("LIGHT ON");
        beep(300);
      }
      else if (blinkCount == 2)
      {
        digitalWrite(led, LOW);
        Serial.println("LIGHT OFF");
        beep(300);
      }
      else if (blinkCount == 3)
      {
        digitalWrite(fan, HIGH);
        Serial.println("FAN ON");
        beep(300);
      }
      else if (blinkCount == 4)
      {
        digitalWrite(fan, LOW);
        Serial.println("FAN OFF");
        beep(300);
      }
      else if (blinkCount == 5)
      {
        digitalWrite(lcd, HIGH);
        Serial.println("TV ON");
        beep(300);
      }
      else if (blinkCount == 6)
      {
        digitalWrite(lcd, LOW);
        Serial.println("TV OFF");
        beep(300);
      }
      else if (blinkCount == 7)
      {
        digitalWrite(massager, HIGH);
        Serial.println("MASSAGER ON");
        beep(300);
      }
      else if (blinkCount == 8)
      {
        digitalWrite(massager, LOW);
        Serial.println("MASSAGER OFF");
        beep(300);
      }
      else
      {
        Serial.println("INVALID COMMAND");
        beep(150);
        delay(100);
        beep(150);
      }

      blinkCount = 0;
      commandMode = false;
      eyeWasClosed = false;

      Serial.println("<<< COMMAND MODE EXITED");

      delay(500);
    }
  }
}
